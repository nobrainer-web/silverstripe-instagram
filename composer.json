	"type": "silverstripe-vendormodule",
	"keywords": [
		"silverstripe",
		"social media",
		"instagram",
		"api",
		"media"
	],
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Bram de Leeuw",
			"homepage": "http://broarm.nl"
		}
	],
	"require": {
		"php": "^8.3",
		"silverstripe/framework": "^6",
		"silverstripe/cms": "^6",
		"silverstripe/siteconfig": "^6",
		"silverstripe/asset-admin": "^3",
		"guzzlehttp/guzzle": "^7"
	},
	"autoload": {
		"psr-4": {
			"Broarm\\Instagram\\": "src"
		}
	}
}
